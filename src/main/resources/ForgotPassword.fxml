<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ForgotPasswordController">
    <children>
        <!-- Formulaire de récupération de mot de passe -->
        <VBox fx:id="formContainer" alignment="CENTER" layoutX="100.0" layoutY="25.0" prefHeight="350.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-border-radius: 5; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <Label text="Edunova" textAlignment="CENTER" textFill="#3498db">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label text="Mot de passe oublié" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label text="Entrez votre adresse email pour recevoir un nouveau mot de passe" textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" left="20.0" right="20.0" />
                    </VBox.margin>
                </Label>
                <TextField fx:id="emailField" maxWidth="300.0" prefHeight="40.0" promptText="Email" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ddd;">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                </TextField>
                <Label fx:id="statusLabel" alignment="CENTER" prefHeight="30.0" prefWidth="280.0" textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <Button fx:id="sendButton" defaultButton="true" disable="true" mnemonicParsing="false" onAction="#handleSendEmail" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #3498db; -fx-background-radius: 5;" text="Envoyer" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </Button>
                <Hyperlink onAction="#handleBackToLogin" text="Retour à la connexion">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Hyperlink>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
        </VBox>

        <!-- Écran de succès (initialement caché) -->
        <VBox fx:id="successContainer" alignment="CENTER" layoutX="100.0" layoutY="25.0" prefHeight="350.0" prefWidth="400.0" spacing="20.0" style="-fx-background-color: white; -fx-border-radius: 5; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <Label text="✓" textFill="#4caf50">
                    <font>
                        <Font size="64.0" />
                    </font>
                </Label>
                <Label text="Email envoyé avec succès!" textAlignment="CENTER" textFill="#4caf50">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Un nouveau mot de passe a été envoyé à votre adresse email. Veuillez consulter votre boîte de réception." textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets left="30.0" right="30.0" />
                    </VBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleBackToLogin" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #3498db; -fx-background-radius: 5;" text="Retour à la connexion" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>
            </children>
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>