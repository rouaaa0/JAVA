<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterUserController" style="-fx-background-color: linear-gradient(to bottom, #e3f2fd, #ffffff); -fx-padding: 20;">
   <children>
      <!-- Input Fields -->
      <TextField fx:id="NameTextField" layoutX="215.0" layoutY="57.0" style="-fx-background-color: #ffffff; -fx-border-color: #4c8bf5; -fx-border-radius: 8; -fx-padding: 5;" />
      <TextField fx:id="LastnameTextField" layoutX="215.0" layoutY="103.0" style="-fx-background-color: #ffffff; -fx-border-color: #4c8bf5; -fx-border-radius: 8; -fx-padding: 5;" />
      <TextField fx:id="EmailTextField" layoutX="215.0" layoutY="156.0" style="-fx-background-color: #ffffff; -fx-border-color: #4c8bf5; -fx-border-radius: 8; -fx-padding: 5;" />
      <PasswordField fx:id="PasswordTextField" layoutX="215.0" layoutY="211.0" style="-fx-background-color: #ffffff; -fx-border-color: #4c8bf5; -fx-border-radius: 8; -fx-padding: 5;" />
      <TextField fx:id="ProfilepicTextField" layoutX="215.0" layoutY="318.0" style="-fx-background-color: #ffffff; -fx-border-color: #4c8bf5; -fx-border-radius: 8; -fx-padding: 5;" />

      <!-- Labels -->
      <Label layoutX="99.0" layoutY="61.0" text="Name" style="-fx-font-size: 14px; -fx-text-fill: #0d47a1; -fx-font-weight: bold;" />
      <Label layoutX="99.0" layoutY="116.0" text="Last Name" style="-fx-font-size: 14px; -fx-text-fill: #0d47a1; -fx-font-weight: bold;" />
      <Label layoutX="99.0" layoutY="160.0" text="Email" style="-fx-font-size: 14px; -fx-text-fill: #0d47a1; -fx-font-weight: bold;" />
      <Label layoutX="90.0" layoutY="215.0" text="Password" style="-fx-font-size: 14px; -fx-text-fill: #0d47a1; -fx-font-weight: bold;" />
      <Label layoutX="94.0" layoutY="272.0" text="Role" style="-fx-font-size: 14px; -fx-text-fill: #0d47a1; -fx-font-weight: bold;" />
      <Label layoutX="94.0" layoutY="322.0" text="Profile Picture" style="-fx-font-size: 14px; -fx-text-fill: #0d47a1; -fx-font-weight: bold;" />

      <!-- Error Labels -->
      <Label fx:id="NameErrorLabel" layoutX="420.0" layoutY="61.0" textFill="RED" style="-fx-font-size: 12px;" />
      <Label fx:id="LastnameErrorLabel" layoutX="420.0" layoutY="116.0" textFill="RED" style="-fx-font-size: 12px;" />
      <Label fx:id="EmailErrorLabel" layoutX="420.0" layoutY="160.0" textFill="RED" style="-fx-font-size: 12px;" />
      <Label fx:id="PasswordErrorLabel" layoutX="420.0" layoutY="215.0" textFill="RED" style="-fx-font-size: 12px;" />
      <Label fx:id="RoleErrorLabel" layoutX="420.0" layoutY="272.0" textFill="RED" style="-fx-font-size: 12px;" />

      <!-- Buttons -->
      <Button fx:id="saveButton" layoutX="433.0" layoutY="370.0" mnemonicParsing="false" onAction="#handleSave" text="Ajouter"
              style="-fx-background-color: linear-gradient(to right, #2193b0, #6dd5ed); -fx-text-fill: white; -fx-font-size: 14px; -fx-border-radius: 8; -fx-padding: 5;" />
      <Button fx:id="cancelButton" layoutX="315.0" layoutY="370.0" mnemonicParsing="false" onAction="#handleCancel" text="Annuler"
              style="-fx-background-color: linear-gradient(to right, #f44336, #e57373); -fx-text-fill: white; -fx-font-size: 14px; -fx-border-radius: 8; -fx-padding: 5;" />

      <!-- ComboBox -->
      <ComboBox fx:id="RoleComboBox" layoutX="215.0" layoutY="268.0" prefWidth="150.0"
                style="-fx-background-color: #ffffff; -fx-border-color: #4c8bf5; -fx-border-radius: 8; -fx-padding: 5;" />
   </children>
</AnchorPane>