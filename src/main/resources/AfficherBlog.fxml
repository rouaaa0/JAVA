<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="controllers.AfficherBlogController"
            prefWidth="900" prefHeight="600" style="-fx-background-color: beige;">
    <children>
        <!-- Title Section -->
        <Text text="Blog Management"
              layoutX="300" layoutY="40"
              style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #004AAD;"/>

        <!-- Search and Sort Section -->
        <HBox layoutX="20" layoutY="80" spacing="10" alignment="CENTER_LEFT" prefWidth="860" style="-fx-padding: 0 0 10 0;">
            <children>
                <TextField fx:id="searchField" promptText="Rechercher par titre..."
                           style="-fx-background-color: white; -fx-pref-width: 300;"
                           onKeyReleased="#handleSearchKeyReleased"/>
                <Pane HBox.hgrow="ALWAYS"/> <!-- Spacer to push the Sort button to the opposite side -->
                <Button text="Sort by Title" onAction="#handleSortByTitle"
                        style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
            </children>
        </HBox>

        <!-- Main Content Section -->
        <VBox layoutX="20" layoutY="120" spacing="20">
            <children>
                <HBox spacing="40" alignment="CENTER">
                    <children>
                        <!-- Form Section -->
                        <VBox spacing="15"
                              style="-fx-background-color: #E8F0FE; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
                              prefWidth="300">
                            <children>
                                <!-- Title -->
                                <Label text="Title" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                                <TextField fx:id="titleField" promptText="Enter Blog Title" style="-fx-background-color: white;"/>
                                <Label fx:id="titleErrorLabel" text="" style="-fx-text-fill: red;"/>

                                <!-- Description -->
                                <Label text="Description" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                                <TextArea
                                        fx:id="descriptionField"
                                        promptText="Enter Blog Description"
                                        style="-fx-background-color: white;"
                                        prefHeight="80"/>
                                <Label fx:id="descriptionErrorLabel" text="" style="-fx-text-fill: red;"/>

                                <!-- Created At -->
                                <Label text="Created At" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                                <DatePicker fx:id="createdAtPicker" style="-fx-background-color: white;"/>
                                <Label fx:id="createdAtErrorLabel" text="" style="-fx-text-fill: red;"/>

                                <!-- Updated At -->
                                <Label text="Updated At" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                                <DatePicker fx:id="updatedAtPicker" style="-fx-background-color: white;"/>
                                <Label fx:id="updatedAtErrorLabel" text="" style="-fx-text-fill: red;"/>

                                <!-- Buttons Section -->
                                <HBox spacing="15" alignment="CENTER">
                                    <Button fx:id="addButton" text="Add"
                                            onAction="#handleAddAction"
                                            style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                            prefWidth="100"/>

                                    <Button fx:id="updateButton" text="Update"
                                            onAction="#handleUpdateAction"
                                            style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                            prefWidth="100"/>

                                    <Button fx:id="deleteButton" text="Delete"
                                            onAction="#handleDeleteAction"
                                            style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                            prefWidth="100"/>
                                </HBox>

                                <!-- History Button -->
                                <Button fx:id="historyButton" text="View History"
                                        onAction="#handleViewHistory"
                                        style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"/>
                            </children>
                        </VBox>

                        <!-- Card Section -->
                        <VBox spacing="20">
                            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-padding: 10; -fx-border-color: #004AAD; -fx-border-width: 2;">
                                <content>
                                    <FlowPane fx:id="cardContainer" hgap="15" vgap="15" prefWrapLength="600" style="-fx-padding: 10;"/>
                                </content>
                            </ScrollPane>

                            <!-- Pagination Controls -->
                            <HBox spacing="10" alignment="CENTER">
                                <Button fx:id="prevPageButton" text="Previous" onAction="#handlePrevPage"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
                                <Label fx:id="currentPageLabel" text="Page 1" style="-fx-font-size: 14px;"/>
                                <Button fx:id="nextPageButton" text="Next" onAction="#handleNextPage"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
                            </HBox>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- History Section (Initially Hidden) -->
        <VBox fx:id="historySection" layoutX="550" layoutY="120" spacing="10"
              visible="false" managed="false"
              style="-fx-background-color: #E8F0FE; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
              prefWidth="300" prefHeight="400">
            <children>
                <Label text="Blog History"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <TextArea fx:id="historyArea" editable="false" wrapText="true"
                          style="-fx-background-color: white; -fx-border-color: #004AAD; -fx-border-width: 2;"
                          prefWidth="280" prefHeight="300"/>

                <!-- Close Button -->
                <Button text="Close"
                        onAction="#handleCloseHistory"
                        style="-fx-background-color: #FF6347; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>