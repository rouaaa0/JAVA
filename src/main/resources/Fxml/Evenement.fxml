<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.chart.PieChart?>
<AnchorPane id="AnchorPane" prefHeight="680.0" prefWidth="919.0" stylesheets="@../css/stylesheet.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="controllers.EvenementController">
    <children>
        <AnchorPane layoutX="-1.0" layoutY="74.0" prefHeight="680.0" prefWidth="240.0" styleClass="sidebar">
            <children>
                <Pane layoutX="30.0" layoutY="37.0" prefHeight="30.0" prefWidth="180.0" styleClass="labbtn">
                    <children>
                        <Label alignment="CENTER" layoutX="41.0" layoutY="6.0" text="Upload New File" textFill="#2262c6">
                            <font>
                                <Font name="Berlin Sans FB" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>
                <Button layoutX="30.0" layoutY="157.0" onAction="#goToUserPage" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/icons8_steering_wheel_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Users">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>

                <Button layoutX="30.0" layoutY="187.0" onAction="#goToBlogPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Blogs">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button layoutX="30.0" layoutY="217.0" onAction="#goToPostPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Posts">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button layoutX="30.0" layoutY="247.0" onAction="#goToEventPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Events">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button layoutX="30.0" layoutY="277.0" onAction="#goToClubPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Clubs">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </AnchorPane>
        <ImageView fitHeight="44.0" fitWidth="51.0" layoutX="38.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/logo.jpeg" />
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="98.0" layoutY="26.0" text="Edunova" textFill="#2262c6">
            <font>
                <Font name="Berlin Sans FB" size="20.0" />
            </font>
        </Label>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="690.0" layoutY="29.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/icons8_bell_24px.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="714.0" layoutY="28.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/icons8_help_32px.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="741.0" layoutY="28.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/icons8_settings_26px.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="873.0" layoutY="29.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/icons8_slider_50px.png" />
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="287.0" layoutY="112.0" text="Evenements" textFill="#2262c6">
            <font>
                <Font name="Berlin Sans FB" size="24.0" />
            </font>
        </Label>
        <VBox fx:id="formVBox" spacing="10.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="160.0">
            <children>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Titre" />
                <TextField fx:id="tTitre" />
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Description" />
                <TextField fx:id="tDescription" />
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Prix" />
                <TextField fx:id="tPrix" />
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Date Début" />
                <DatePicker fx:id="tDateDebut" />
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Date Fin" />
                <DatePicker fx:id="tDateFin" />
                <ImageView fx:id="imageView" fitHeight="100.0" fitWidth="100.0" />
            </children>
        </VBox>
        <ListView fx:id="eventListView" layoutX="250.0" layoutY="80.0" prefHeight="310.0" prefWidth="420.0" AnchorPane.topAnchor="160.0"/>

        <HBox spacing="10.0" alignment="CENTER" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Button text="⏮ Précédent" onAction="#previousPage"/>
            <Button text="Suivant ⏭" onAction="#nextPage"/>
            <children>
                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#createEvenement" text="Save" />
                <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#updateEvenement" text="Update" />
                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#deleteEvenement" text="Delete" />
                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#clear" text="Clear" />
            </children>
        </HBox>
        <PieChart fx:id="eventPieChart" layoutX="320" layoutY="420" prefWidth="300" prefHeight="300"/>
    </children>
</AnchorPane>
