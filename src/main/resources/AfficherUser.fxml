<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<AnchorPane id="AnchorPane" prefHeight="580.0" prefWidth="919.0" stylesheets="@css/stylesheet.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="controllers.AfficherUserController">
    <children>
        <!-- Sidebar Section -->
        <AnchorPane layoutX="-1.0" layoutY="74.0" prefHeight="720.0" prefWidth="240.0" styleClass="sidebar">
            <children>
                <Button layoutX="26.0" layoutY="122.0" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn"
                        onAction="#goToMyDrivePage">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@images/icons8_steering_wheel_64px.png" />
                                    </image>
                                </ImageView>
                                <Label text="Users" styleClass="sidebar-btn-text">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <HBox alignment="CENTER_LEFT" layoutX="31.0" layoutY="185.0" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn-text">
                    <children>
                        <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/icons8_windows_homegroup_32px.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label text="Shared with me" textFill="#a2bee8">
                            <font>
                                <Font name="Cambria" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="32.0" layoutY="215.0" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn-text">
                    <children>
                        <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/icons8_time_machine_30px.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label text="Recent" textFill="#a2bee8">
                            <font>
                                <Font name="Cambria" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="31.0" layoutY="246.0" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn-text">
                    <children>
                        <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/icons8_star_50px.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label text="Starred" textFill="#a2bee8">
                            <font>
                                <Font name="Cambria" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="31.0" layoutY="277.0" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn-text">
                    <children>
                        <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/icons8_empty_trash_32px.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label text="Trash" textFill="#a2bee8">
                            <font>
                                <Font name="Cambria" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="5.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="32.0" layoutY="307.0" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn-text">
                    <children>
                        <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/icons8_sync_settings_24px.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label text="Backups" textFill="#a2bee8">
                            <font>
                                <Font name="Cambria" size="14.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="5.0" />
                    </padding>
                </HBox>
                <Label alignment="CENTER" layoutX="32.0" layoutY="361.0" text="Strorage Details" textFill="#a2bee8">
                    <font>
                        <Font name="Berlin Sans FB" size="16.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <!-- Header with Logo, Title and Logout Button -->
        <HBox layoutX="0.0" layoutY="0.0" prefHeight="70.0" prefWidth="919.0" style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-width: 0 0 1 0;">
            <children>
                <!-- Logo and Title Group -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fitHeight="44.0" fitWidth="51.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/logo.jpeg" />
                            </image>
                        </ImageView>
                        <Label alignment="CENTER" text="Edunova" textFill="#2262c6">
                            <font>
                                <Font name="Berlin Sans FB" size="20.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="38.0" />
                    </padding>
                </HBox>

                <!-- Title aligned center -->
                <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <children>
                        <Text text="User Management" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #004AAD;"/>
                    </children>
                </HBox>

                <!-- Logout button aligned right -->
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button text="Logout"
                                onAction="#handleLogout"
                                style="-fx-background-color: #FF0000; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@/images/icons8-logout-rounded-50.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets right="20.0" />
                    </padding>
                </HBox>
            </children>
        </HBox>

        <!-- Search field -->
        <HBox layoutX="250" layoutY="80" spacing="10" alignment="CENTER">
            <children>
                <Label text="Search by Name:" style="-fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <TextField fx:id="searchField" promptText="Type to search..."
                           style="-fx-background-color: white; -fx-border-color: #004AAD; -fx-border-width: 2;"/>
            </children>
        </HBox>

        <!-- Sort combobox -->
        <HBox spacing="10" alignment="CENTER_RIGHT" layoutX="700" layoutY="80">
            <children>
                <Label text="Sort By:" style="-fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <ComboBox fx:id="sortOrderComboBox" promptText="Select Order"
                          style="-fx-background-color: white; -fx-border-color: #004AAD; -fx-border-width: 2;"/>
            </children>
        </HBox>

        <!-- Main Content Section -->
        <HBox layoutX="250" layoutY="115" spacing="10" alignment="CENTER">
            <children>
                <!-- Form Section -->
                <VBox spacing="10"
                      style="-fx-background-color: #E8F0FE; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
                      prefWidth="300">
                    <children>
                        <!-- Name -->
                        <Label text="Name" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextField fx:id="nameField" promptText="Enter Name" style="-fx-background-color: white;"/>
                        <Label fx:id="nameErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Lastname -->
                        <Label text="Lastname" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextField fx:id="lastnameField" promptText="Enter Lastname" style="-fx-background-color: white;"/>
                        <Label fx:id="lastnameErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Email -->
                        <Label text="Email" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextField fx:id="emailField" promptText="Enter Email" style="-fx-background-color: white;"/>
                        <Label fx:id="emailErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Role -->
                        <Label text="Role" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="roleComboBox" promptText="Select Role" style="-fx-background-color: white;"/>
                        <Label fx:id="roleErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Password -->
                        <Label text="Password" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" promptText="Enter Password" style="-fx-background-color: white;"/>
                        <Label fx:id="passwordErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Profile Picture Section -->
                        <Label text="Profile Picture" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <ImageView fx:id="profilePicturePreview"
                                   fitWidth="50" fitHeight="50"
                                   style="-fx-border-color: #004AAD; -fx-border-width: 2; -fx-border-radius: 5;"/>
                        <Button text="Upload Picture"
                                onAction="#handleProfilePictureUpload"
                                style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                        <!-- Buttons Section -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="addButton" text="Add"
                                    onAction="#handleAddAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                    prefWidth="80"/>

                            <Button fx:id="updateButton" text="Update"
                                    onAction="#handleUpdateAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                    prefWidth="80"/>

                            <Button fx:id="deleteButton" text="Delete"
                                    onAction="#handleDeleteAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                    prefWidth="80"/>
                        </HBox>

                        <!-- Statistique Button -->
                        <Button fx:id="statistiqueButton" text="Statistique"
                                onAction="#handleStatistiqueAction"
                                style="-fx-background-color: #23A123; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                prefWidth="80" alignment="CENTER"/>
                    </children>
                </VBox>

                <!-- Card Section with Pagination -->
                <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #004AAD; -fx-border-width: 2; -fx-background-color: white;">
                    <children>
                        <!-- Card Container -->
                        <ScrollPane fitToWidth="true" fitToHeight="true">
                            <content>
                                <FlowPane fx:id="cardContainer" hgap="15" vgap="15" style="-fx-padding: 10;"/>
                            </content>
                        </ScrollPane>

                        <!-- Pagination Section -->
                        <HBox spacing="10" alignment="CENTER">
                            <children>
                                <Button fx:id="previousButton" text="Previous"
                                        onAction="#handlePreviousPage"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                                <Label fx:id="pageNumberLabel" text="Page: 1"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #004AAD;"/>

                                <Button fx:id="nextButton" text="Next"
                                        onAction="#handleNextPage"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Role Statistics Section -->
        <VBox fx:id="roleStatisticsContainer" layoutX="600" layoutY="115" spacing="10" visible="false" managed="false"
              style="-fx-background-color: #E8F0FE; -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
              prefWidth="250">
            <children>
                <Label text="Role Statistics" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <PieChart fx:id="rolePieChart" prefWidth="200" prefHeight="200"/>
                <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;" visible="false"/>
            </children>
        </VBox>
    </children>
</AnchorPane>