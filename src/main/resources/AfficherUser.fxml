<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="controllers.AfficherUserController"
            prefWidth="900" prefHeight="600" style="-fx-background-color: beige;">
    <children>
        <!-- Title Section -->
        <Text text="User Management"
              layoutX="300" layoutY="40"
              style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #004AAD;"/>

        <!-- Main Content Section -->
        <HBox layoutX="20" layoutY="80" spacing="20" alignment="CENTER">
            <children>
                <!-- Form Section -->
                <VBox spacing="15"
                      style="-fx-background-color: #E8F0FE; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
                      prefWidth="300">
                    <children>
                        <!-- Name -->
                        <Label text="Name" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextField fx:id="nameField" promptText="Enter Name" style="-fx-background-color: white;"/>
                        <Label fx:id="nameErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Lastname -->
                        <Label text="Lastname" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextField fx:id="lastnameField" promptText="Enter Lastname" style="-fx-background-color: white;"/>
                        <Label fx:id="lastnameErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Email -->
                        <Label text="Email" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextField fx:id="emailField" promptText="Enter Email" style="-fx-background-color: white;"/>
                        <Label fx:id="emailErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Role -->
                        <Label text="Role" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="roleComboBox" promptText="Select Role" style="-fx-background-color: white;"/>
                        <Label fx:id="roleErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Password -->
                        <Label text="Password" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" promptText="Enter Password" style="-fx-background-color: white;"/>
                        <Label fx:id="passwordErrorLabel" text="" style="-fx-text-fill: red;"/>

                        <!-- Profile Picture Section -->
                        <Label text="Profile Picture" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <ImageView fx:id="profilePicturePreview"
                                   fitWidth="50" fitHeight="50"
                                   style="-fx-border-color: #004AAD; -fx-border-width: 2; -fx-border-radius: 5;"/>
                        <Button text="Upload Picture"
                                onAction="#handleProfilePictureUpload"
                                style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                        <!-- Buttons Section -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button fx:id="addButton" text="Add"
                                    onAction="#handleAddAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                    prefWidth="100"/>

                            <Button fx:id="updateButton" text="Update"
                                    onAction="#handleUpdateAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                    prefWidth="100"/>

                            <Button fx:id="deleteButton" text="Delete"
                                    onAction="#handleDeleteAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                    prefWidth="100"/>
                        </HBox>

                        <!-- Statistique Button -->
                        <Button fx:id="statistiqueButton" text="Statistique"
                                onAction="#handleStatistiqueAction"
                                style="-fx-background-color: #23A123; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"
                                prefWidth="150" alignment="CENTER"/>
                    </children>
                </VBox>

                <!-- Card Section with Pagination -->
                <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #004AAD; -fx-border-width: 2; -fx-background-color: white;">
                    <children>
                        <!-- Card Container -->
                        <ScrollPane fitToWidth="true" fitToHeight="true">
                            <content>
                                <FlowPane fx:id="cardContainer" hgap="15" vgap="15" style="-fx-padding: 10;"/>
                            </content>
                        </ScrollPane>

                        <!-- Pagination Section -->
                        <HBox spacing="20" alignment="CENTER">
                            <children>
                                <Button fx:id="previousButton" text="Previous"
                                        onAction="#handlePreviousPage"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                                <Label fx:id="pageNumberLabel" text="Page: 1"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #004AAD;"/>

                                <Button fx:id="nextButton" text="Next"
                                        onAction="#handleNextPage"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Role Statistics Section -->
        <VBox fx:id="roleStatisticsContainer" layoutX="600" layoutY="80" spacing="10" visible="false" managed="false"
              style="-fx-background-color: #E8F0FE; -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
              prefWidth="250">
            <children>
                <Label text="Role Statistics" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <PieChart fx:id="rolePieChart" prefWidth="200" prefHeight="200"/>
                <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;" visible="false"/>
            </children>
        </VBox>

        <!-- Add this TextField for search -->
        <HBox layoutX="20" layoutY="45" spacing="10" alignment="CENTER">
            <children>
                <Label text="Search by Name:" style="-fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <TextField fx:id="searchField" promptText="Type to search..."
                           style="-fx-background-color: white; -fx-border-color: #004AAD; -fx-border-width: 2;"/>
            </children>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT" layoutX="700" layoutY="45">
            <children>
                <Label text="Sort By:" style="-fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <ComboBox fx:id="sortOrderComboBox" promptText="Select Order"
                          style="-fx-background-color: white; -fx-border-color: #004AAD; -fx-border-width: 2;"/>
            </children>
        </HBox>

    </children>
</AnchorPane>