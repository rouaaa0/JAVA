<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RegisterController"
            prefWidth="800.0" prefHeight="600.0"
            style="-fx-background-color: #f4f7f9; -fx-padding: 30px;">
    <children>
        <!-- Title -->
        <Text layoutX="275.0" layoutY="50.0" text="Créer Un Compte"
              strokeType="OUTSIDE" strokeWidth="0.0" fill="#333">
            <font>
                <Font size="28.0"/>
            </font>
        </Text>

        <!-- Nom et Prénom -->
        <Label layoutX="100.0" layoutY="100.0" text="Nom :" />
        <TextField fx:id="nameField" layoutX="200.0" layoutY="95.0" prefWidth="220.0" promptText="Entrez votre nom"
                   style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
        <Label fx:id="nameErrorLabel" layoutX="200.0" layoutY="125.0" textFill="red" text=""/>

        <Label layoutX="450.0" layoutY="100.0" text="Prénom :" />
        <TextField fx:id="lastnameField" layoutX="550.0" layoutY="95.0" prefWidth="220.0" promptText="Entrez votre prénom"
                   style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
        <Label fx:id="lastnameErrorLabel" layoutX="550.0" layoutY="125.0" textFill="red" text=""/>

        <!-- Email -->
        <Label layoutX="100.0" layoutY="160.0" text="Email :" />
        <TextField fx:id="emailField" layoutX="200.0" layoutY="155.0" prefWidth="570.0" promptText="exemple@email.com"
                   style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
        <Label fx:id="emailErrorLabel" layoutX="200.0" layoutY="185.0" textFill="red" text=""/>

        <!-- Mot de passe -->
        <Label layoutX="100.0" layoutY="220.0" text="Mot de passe :" />

        <!-- Password fields with control buttons -->
        <HBox spacing="10" layoutX="250.0" layoutY="215.0">
            <PasswordField fx:id="passwordField" prefWidth="300.0" promptText="Mot de passe"
                           style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
            <TextField fx:id="visiblePasswordField" prefWidth="300.0"
                       visible="false" managed="false"
                       style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
            <Button fx:id="showPasswordButton" text="Afficher" onAction="#handleShowPasswordAction"
                    style="-fx-background-radius: 10; -fx-background-color: #f0f0f0;"/>
            <Button fx:id="generatePasswordButton" text="Générer" onAction="#handleGeneratePasswordAction"
                    style="-fx-background-radius: 10; -fx-background-color: #0077cc; -fx-text-fill: white;"/>
        </HBox>
        <Label fx:id="passwordErrorLabel" layoutX="250.0" layoutY="245.0" textFill="red" text=""/>

        <!-- Profile Picture -->
        <Label layoutX="100.0" layoutY="280.0" text="Profile Picture :" />
        <Button text="Upload Picture" layoutX="250.0" layoutY="275.0" onAction="#handleUploadProfilePicture"
                style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-background-color: #0077cc; -fx-text-fill: white;"/>
        <ImageView fx:id="profilePicturePreview" layoutX="400.0" layoutY="260.0" fitWidth="150.0" fitHeight="150.0"
                   style="-fx-border-color: #004AAD; -fx-border-width: 2;"/>
        <Label fx:id="profilePicErrorLabel" layoutX="250.0" layoutY="310.0" textFill="red"/>

        <!-- Bouton Inscription -->
        <Button text="✅ S'inscrire"
                layoutX="325.0" layoutY="450.0"
                prefHeight="50.0" prefWidth="200.0"
                onAction="#handleRegisterAction"
                style="-fx-background-color: linear-gradient(to right, #2193b0, #6dd5ed);
                       -fx-text-fill: white;
                       -fx-font-size: 16px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 25;
                       -fx-cursor: hand;" />

        <!-- Bouton retour -->
        <Button layoutX="20.0" layoutY="20.0"
                onAction="#cancelAction"
                style="-fx-background-color: transparent;
                       -fx-border-color: transparent;
                       -fx-cursor: hand;">
            <graphic>
                <ImageView fitHeight="35.0" fitWidth="35.0" preserveRatio="true">
                    <image>
                        <Image url="@image/122637.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Message global -->
        <Label fx:id="messageLabel"
               text=""
               visible="false"
               layoutX="200.0" layoutY="520.0"
               style="-fx-font-size: 14px; -fx-text-fill: #00796B;" />
    </children>
</AnchorPane>