<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<AnchorPane id="AnchorPane" prefHeight="580.0" prefWidth="919.0" stylesheets="@css/stylesheet.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="controllers.AfficherPostController">
    <children>
        <AnchorPane layoutX="-1.0" layoutY="74.0" prefHeight="506.0" prefWidth="240.0" styleClass="sidebar">
            <children>
                <Button layoutX="30.0" layoutY="157.0" onAction="#goToUserPage" prefHeight="30.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@images/icons8_steering_wheel_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Users">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>

                <Button layoutX="30.0" layoutY="187.0" onAction="#goToBlogPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Blogs">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button layoutX="30.0" layoutY="217.0" onAction="#goToPostPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Posts">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button layoutX="30.0" layoutY="247.0" onAction="#goToEventPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Events">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button layoutX="30.0" layoutY="277.0" onAction="#goToClubPage" prefHeight="0.0" prefWidth="180.0" styleClass="sidebar-btn">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@image/icons8_book_64px.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="sidebar-btn-text" text="Clubs">
                                    <font>
                                        <Font name="Cambria" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </AnchorPane>
        <ImageView fitHeight="44.0" fitWidth="51.0" layoutX="38.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/logo.jpeg" />
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="98.0" layoutY="26.0" text="Edunova" textFill="#2262c6">
            <font>
                <Font name="Berlin Sans FB" size="20.0" />
            </font>
        </Label>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="690.0" layoutY="29.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/icons8_bell_24px.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="714.0" layoutY="28.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/icons8_help_32px.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="741.0" layoutY="28.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/icons8_settings_26px.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="22.0" fitWidth="18.0" layoutX="873.0" layoutY="29.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/icons8_slider_50px.png" />
            </image>
        </ImageView>

        <Text text="Post Management"
              layoutX="300" layoutY="40"
              style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #004AAD;"/>

        <!-- Search and Sort Section -->
        <HBox layoutX="250" layoutY="80" spacing="10" alignment="CENTER_LEFT"  prefWidth="460" style="-fx-padding: 0 0 10 0;">
            <children>
                <!-- Search Field -->
                <TextField fx:id="searchField" promptText="Rechercher par contenu..."
                           style="-fx-background-color: white; -fx-pref-width: 300;"
                           onKeyReleased="#handleSearchKeyReleased"/>

                <!-- Sort Button -->
                <Button text="Sort by Content" onAction="#handleSortByContent"
                        style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
            </children>
        </HBox>

        <!-- Modified Existing Section -->
        <HBox layoutX="250" layoutY="120" spacing="10" alignment="CENTER">
            <children>
                <VBox spacing="5"
                      style="-fx-background-color: #E8F0FE; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
                      prefWidth="300">
                    <children>
                        <Label text="Content" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <TextArea fx:id="contentField" promptText="Enter Post Content" style="-fx-background-color: white;" prefHeight="80"/>
                        <Label text="Image" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <ImageView fx:id="postImagePreview" fitWidth="50" fitHeight="50" style="-fx-border-color: gray; -fx-border-width: 2;"/>
                        <Button text="Upload Image" onAction="#handlePostImageUpload"
                                style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>

                        <Label text="Created At" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="createdAtPicker" style="-fx-background-color: white;"/>

                        <Label text="Updated At" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="updatedAtPicker" style="-fx-background-color: white;"/>

                        <Label text="Blog" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="blogComboBox" promptText="Select Associated Blog" style="-fx-background-color: white;"/>

                        <!-- Spell Check Section - ADDED HERE -->
                        <VBox spacing="5">
                            <Label text="Spell Check" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                            <CheckBox fx:id="spellCheckEnabledCheckBox" text="Enable spell checking" selected="false"/>
                            <HBox spacing="5">
                                <Button fx:id="checkSpellingButton" text="Check Spelling" onAction="#handleCheckSpelling"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
                                <Button text="Auto-Correct" onAction="#handleAutoCorrect"
                                        style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
                            </HBox>
                            <TextArea fx:id="spellErrorsArea" promptText="Spelling errors will appear here"
                                      style="-fx-background-color: white;" prefHeight="60" editable="false"/>
                        </VBox>
                        <!-- Add this after the Spell Check section in your form VBox -->
                        <VBox spacing="5">
                            <Label text="Sentiment Analysis" style="-fx-text-fill: #004AAD; -fx-font-weight: bold;"/>
                            <Button fx:id="analyzeSentimentButton" text="Analyze Sentiment" onAction="#handleAnalyzeSentiment"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>

                            <!-- Sentiment Result Display -->
                            <HBox fx:id="sentimentContainer" spacing="10" alignment="CENTER_LEFT" visible="false">
                                <Label text="Result:" style="-fx-font-weight: bold;"/>
                                <Label fx:id="sentimentResultLabel" text="" style="-fx-font-weight: bold;"/>
                                <ProgressBar fx:id="sentimentScoreBar" progress="0.5" prefWidth="150"/>
                            </HBox>
                        </VBox>

                        <!-- Buttons: Add, Update, Delete, View Stats, and View History -->
                        <HBox spacing="5" alignment="CENTER">
                            <Button text="Add" onAction="#handleAddAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px;" prefWidth="80"/>
                            <Button text="Update" onAction="#handleUpdateAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px;" prefWidth="80"/>
                            <Button text="Delete" onAction="#handleDeleteAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px;" prefWidth="80"/>
                            <Button text="View Stats" onAction="#handleViewStatsAction"
                                    style="-fx-background-color: #004AAD; -fx-text-fill: white; -fx-font-size: 11px;" prefWidth="80"/>
                        </HBox>

                        <!-- History Button -->
                        <Button fx:id="historyButton" text="View History"
                                onAction="#handleViewHistory"
                                style="-fx-background-color: #FFA500; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"/>
                    </children>
                </VBox>

                <!-- Card Section with Pagination Below -->
                <VBox spacing="10">
                    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-padding: 10; -fx-border-color: #004AAD; -fx-border-width: 2;">
                        <content>
                            <FlowPane fx:id="cardContainer" hgap="15" vgap="15" prefHeight="400"  style="-fx-padding: 10;"/>
                        </content>
                    </ScrollPane>

                    <!-- Pagination Controls -->
                    <HBox spacing="5" alignment="CENTER">
                        <Button fx:id="prevPageButton" text="Previous" onAction="#handlePrevPage"
                                style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
                        <Label fx:id="currentPageLabel" text="Page 1" style="-fx-font-size: 14px;"/>
                        <Button fx:id="nextPageButton" text="Next" onAction="#handleNextPage"
                                style="-fx-background-color: #004AAD; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </children>
        </HBox>

        <!-- PieChart for Dynamic Stats -->
        <VBox spacing="20" alignment="CENTER" layoutX="650" layoutY="350">
            <children>
                <Text text="" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <PieChart fx:id="statsPieChart" prefHeight="250" prefWidth="250" />
            </children>
        </VBox>

        <!-- History Section (Initially Hidden) -->
        <VBox fx:id="historySection" layoutX="550" layoutY="120" spacing="10"
              visible="false" managed="false"
              style="-fx-background-color: #E8F0FE; -fx-padding: 20; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #004AAD; -fx-border-width: 2;"
              prefWidth="300" prefHeight="287">
            <children>
                <Label text="Post History"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004AAD;"/>
                <TextArea fx:id="historyArea" editable="false" wrapText="true"
                          style="-fx-background-color: white; -fx-border-color: #004AAD; -fx-border-width: 2;"
                          prefWidth="280" prefHeight="300"/>

                <!-- Close Button -->
                <Button text="Close"
                        onAction="#handleCloseHistory"
                        style="-fx-background-color: #FF6347; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>