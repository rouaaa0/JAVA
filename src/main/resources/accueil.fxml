<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="594.0" prefWidth="1011.0" stylesheets="@css/stylesheet1.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AccueilController">

    <children>
        <!-- Navbar -->
        <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="981.0" spacing="20.0" style="-fx-background-color: #ffffff;" styleClass="navbar">
            <children>
                <!-- Logo -->
                <ImageView fitHeight="44.0" fitWidth="51.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/logo.jpeg" />
                    </image>
                </ImageView>

                <Label text="Edunova" textFill="#2262c6">
                    <font>
                        <Font name="Berlin Sans FB" size="20.0" />
                    </font>
                </Label>

                <Button styleClass="nav-item" text="Accueil" textFill="#2262c6" />
                <Button styleClass="nav-item" text="Evenements" textFill="#2262c6" />
                <Button styleClass="nav-item" text="Clubs" textFill="#2262c6" />
                <Button onAction="#goToBlogPage" styleClass="nav-item" text="Blogs" textFill="#2262c6" />
                <Button styleClass="nav-item" text="Utilisateurs" textFill="#2262c6" />

                <HBox HBox.hgrow="ALWAYS" />

                <!-- Theme Toggle Button -->
                <!-- Theme Toggle Button -->
                <ToggleButton fx:id="themeToggle" onAction="#handleThemeToggle" style="-fx-background-color: #ffffff; -fx-text-fill: #2262c6; -fx-font-weight: bold; -fx-padding: 3 10; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.3), 5, 0.2, 0, 0);" text="Dark Mode" />

                <!-- Profile Button -->
                <Button onAction="#navigateToProfile" style="-fx-background-color: #ffffff; -fx-text-fill: #2262c6; -fx-font-weight: bold; -fx-padding: 3 10; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.3), 5, 0.2, 0, 0);" text="Profile" />

                <!-- Logout Button -->
                <Button onAction="#handleLogoutAction" style="-fx-background-color: #FF5555; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 3 10; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.3), 5, 0.2, 0, 0);" text="Déconnexion" />
            </children>
            <padding>
                <Insets left="10.0" right="10.0" />
            </padding>
        </HBox>

        <!-- Main Content Area -->
        <AnchorPane layoutX="0.0" layoutY="60.0" prefHeight="516.0" prefWidth="1011.0">
            <children>
                <!-- Titre principal -->
                <Label layoutX="73.0" layoutY="30.0" text="Bienvenue sur Edunova" textFill="#2262c6">
                    <font>
                        <Font name="Berlin Sans FB" size="24.0" />
                    </font>
                </Label>

                <!-- Sous-titre -->
                <Label layoutX="73.0" layoutY="70.0" text="Votre plateforme éducative en ligne" textFill="#545352">
                    <font>
                        <Font name="Berlin Sans FB" size="14.0" />
                    </font>
                </Label>

                <!-- Featured Cards Section -->
                <Label layoutX="73.0" layoutY="120.0" text="Recommandés pour vous" textFill="#545352">
                    <font>
                        <Font name="Berlin Sans FB" size="14.0" />
                    </font>
                </Label>

                <!-- Featured Cards HBox -->
                <HBox layoutX="73.0" layoutY="150.0" prefHeight="150.0" prefWidth="835.0" spacing="20.0">
                    <!-- Card 1 -->
                    <AnchorPane prefHeight="140.0" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                        <effect>
                            <DropShadow />
                        </effect>
                        <Label layoutX="20.0" layoutY="20.0" text="Blogs Récents" textFill="#2262c6">
                            <font>
                                <Font name="Berlin Sans FB" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="20.0" layoutY="50.0" text="Découvrez les derniers articles" textFill="#545352">
                            <font>
                                <Font name="System" size="12.0" />
                            </font>
                        </Label>
                        <Button layoutX="20.0" layoutY="90.0" onAction="#goToBlogPage" style="-fx-background-color: #2262c6; -fx-text-fill: white;" text="Explorer" />
                    </AnchorPane>

                    <!-- Card 2 -->
                    <AnchorPane prefHeight="140.0" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                        <effect>
                            <DropShadow />
                        </effect>
                        <Label layoutX="20.0" layoutY="20.0" text="Événements à venir" textFill="#2262c6">
                            <font>
                                <Font name="Berlin Sans FB" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="20.0" layoutY="50.0" text="Ne manquez aucun événement" textFill="#545352">
                            <font>
                                <Font name="System" size="12.0" />
                            </font>
                        </Label>
                        <Button layoutX="20.0" layoutY="90.0" style="-fx-background-color: #2262c6; -fx-text-fill: white;" text="Voir le calendrier" />
                    </AnchorPane>

                    <!-- Card 3 -->
                    <AnchorPane prefHeight="140.0" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                        <effect>
                            <DropShadow />
                        </effect>
                        <Label layoutX="20.0" layoutY="20.0" text="Clubs" textFill="#2262c6">
                            <font>
                                <Font name="Berlin Sans FB" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="20.0" layoutY="50.0" text="Rejoignez nos clubs étudiants" textFill="#545352">
                            <font>
                                <Font name="System" size="12.0" />
                            </font>
                        </Label>
                        <Button layoutX="20.0" layoutY="90.0" style="-fx-background-color: #2262c6; -fx-text-fill: white;" text="Découvrir" />
                    </AnchorPane>
                </HBox>

                <!-- Recent Activities Section -->
                <Label layoutX="73.0" layoutY="320.0" text="Activités récentes" textFill="#545352">
                    <font>
                        <Font name="Berlin Sans FB" size="14.0" />
                    </font>
                </Label>

                <!-- Activities ScrollPane -->
                <ScrollPane fitToWidth="true" layoutX="73.0" layoutY="350.0" prefHeight="165.0" prefWidth="835.0" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox spacing="10.0">
                        <!-- Activity 1 -->
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 10;">
                            <effect>
                                <DropShadow />
                            </effect>
                            <Label style="-fx-font-weight: bold;" text="Nouveau blog publié: Introduction à Java" textFill="#2262c6" />
                            <Label text="Il y a 2 heures" textFill="#545352" />
                        </HBox>

                        <!-- Activity 2 -->
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 10;">
                            <effect>
                                <DropShadow />
                            </effect>
                            <Label style="-fx-font-weight: bold;" text="Événement à venir: Workshop JavaFX" textFill="#2262c6" />
                            <Label text="Demain, 14:00" textFill="#545352" />
                        </HBox>

                        <!-- Activity 3 -->
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 10;">
                            <effect>
                                <DropShadow />
                            </effect>
                            <Label style="-fx-font-weight: bold;" text="Club de programmation: Réunion hebdomadaire" textFill="#2262c6" />
                            <Label text="Vendredi, 16:30" textFill="#545352" />
                        </HBox>

                    </VBox>
                </ScrollPane>
                <Button fx:id="chatButton" layoutX="889.0" layoutY="48.0" style="-fx-background-color: linear-gradient(to bottom right, #3498db, #2980b9); -fx-background-radius: 50%; -fx-min-width: 60px; -fx-min-height: 60px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 0);">
                    <graphic>
                        <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                            <image>
                                <Image url="@image/chat_icon.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </AnchorPane>

        <!-- Footer -->
        <HBox alignment="CENTER" layoutX="0.0" layoutY="540.0" prefHeight="40.0" prefWidth="981.0" style="-fx-background-color: #2262c6;">
            <children>
                <Label text="© 2025 Edunova. Tous droits réservés." textFill="WHITE">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </children>
</AnchorPane>
